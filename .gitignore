# Local vendor evidence and archives are intentionally not synchronized.
reference/

# Build logs and temporary reports stay local. The handwritten audit report is
# the only committed file under build/.
build/*
!build/.gitkeep
!build/task-report.md

# Machine-local tool paths and transient Codex files.
tools/local.env.ps1
.codex-log/
tmp/

# Keil/CubeMX user state and build products.
*.uvguix.*
*.uvoptx
*.axf
*.hex
*.bin
*.o
*.obj
*.d
*.crf
*.map
*.lst
*.lnp
*.dep
*.bak
*.tmp
*.log
target/c5-firmware/MDK-ARM/c5-firmware/
target/c5-firmware/MDK-ARM/DebugConfig/
target/c5-firmware/MDK-ARM/RTE/

# Language-local caches.
__pycache__/
.venv/

# Local Orange Pi assets and imported tool state.
target/rkn3588-yolov8.zip
target/rk3588-goalkeeper/.idea/
target/rk3588-goalkeeper/.claude/
target/rk3588-goalkeeper/CLAUDE.md
target/rk3588-goalkeeper/docs/agents/
target/rk3588-goalkeeper/*.whl
target/rk3588-goalkeeper/*.mp4
target/rk3588-goalkeeper/capture_*.jpg
target/rk3588-goalkeeper/capture_*.png
target/rk3588-goalkeeper/rknnModel/
