[Unit]
Description=C5 RK3588 Goalkeeper Headless Dry Run
After=local-fs.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=orangepi
Group=orangepi
WorkingDirectory=/home/orangepi/c5-car-playground/target/rk3588-goalkeeper
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/home/orangepi/miniconda3/envs/yolov8/bin/python3 /home/orangepi/c5-car-playground/target/rk3588-goalkeeper/service_preflight.py --model ./rknnModel/football_8_16_100.rknn --camera /dev/video0 --wait 30
ExecStart=/home/orangepi/miniconda3/envs/yolov8/bin/python3 /home/orangepi/c5-car-playground/target/rk3588-goalkeeper/main.py --headless --mode goalkeeper-test --dry-run-duration 7200
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
